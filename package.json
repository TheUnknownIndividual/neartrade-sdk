{
  "name": "@neartrade/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the neartrade developer API: quotes, swaps and token discovery for every NEAR launchpad and Rhea pool, paid in NEAR or USDC.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:live": "tsx test/live.ts"
  },
  "peerDependencies": {
    "near-api-js": ">=5"
  },
  "peerDependenciesMeta": {
    "near-api-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "near-api-js": "7.3.1",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "@types/node": "22.10.1"
  },
  "keywords": [
    "near",
    "neartrade",
    "swap",
    "dex",
    "launchpad",
    "rhea",
    "sdk",
    "trading"
  ],
  "homepage": "https://dev.neartrade.lol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheUnknownIndividual/neartrade-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/TheUnknownIndividual/neartrade-sdk/issues"
  },
  "author": "neartrade (https://www.neartrade.lol)",
  "publishConfig": {
    "access": "public"
  }
}
